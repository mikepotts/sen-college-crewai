# User postcode for local filtering
USER_POSTCODE=LS1 1AA

# OpenAI API credentials for GenAI prompt-based search
# Required for /instant endpoint prompt parameter to extract structured profiles from natural language
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

# CORS origins for frontend access (comma-separated list)
# If not set, defaults to common development ports (localhost:5173, localhost:3000, etc.)
# Example for production: CORS_ORIGINS=https://myapp.com,https://www.myapp.com
# CORS_ORIGINS=

# Azure OpenAI (alternative to OpenAI)
# AZURE_OPENAI_API_KEY=
# AZURE_OPENAI_ENDPOINT=
# OPENAI_API_TYPE=azure
# OPENAI_API_VERSION=2024-08-01-preview
